  <script is:inline>
    var _formCooldown = false;

    function sanitize(str) {
      if (!str) return '';
      return str.replace(/<[^>]*>/g, '').trim();
    }

    function handleFormSubmit(e) {
      // Rate-limit: block rapid re-submissions
      if (_formCooldown) {
        e.preventDefault();
        return;
      }

      var form = document.getElementById('boston-web3-form');
      var btn = document.getElementById('form-submit-btn');
      var success = document.getElementById('form-success');
      var errorEl = document.getElementById('form-error');

      // Honeypot check — if filled, block submit silently
      if (form.elements['website'] && form.elements['website'].value) {
        e.preventDefault();
        form.style.display = 'none';
        success.style.display = 'block';
        return;
      }

      // Sanitize inputs in-place before native form submit
      form.elements['name'].value = sanitize(form.elements['name'].value);
      form.elements['x_handle'].value = sanitize(form.elements['x_handle'].value);

      // Disable button + cooldown
      btn.disabled = true;
      btn.textContent = 'Submitting…';
      _formCooldown = true;
      errorEl.style.display = 'none';

      // Let the native form submit to the hidden iframe (action + target set in HTML)
      // Show success after a short delay (iframe won't fire readable load cross-origin)
      setTimeout(function () {
        form.style.display = 'none';
        success.style.display = 'block';
      }, 1500);

      setTimeout(function () { _formCooldown = false; }, 5000);
    }

    document.addEventListener('DOMContentLoaded', function () {
      // ── Carl's Corner guest slider + bar extension ──
      var slider = document.getElementById('carls-slider');
      var countEl = document.getElementById('carls-count');
      var totalEl = document.getElementById('carls-total');
      var badgeEl = document.getElementById('carls-price-badge');
      var carlsBarCheck = document.getElementById('carls-bar-check');
      var carlsBarPrice = document.getElementById('carls-bar-price');
      var pricePerPerson = 285;
      var carlsBarRate = 40;

      function updateCarls() {
        var guests = parseInt(slider.value, 10);
        var base = guests * pricePerPerson;
        var barCost = carlsBarCheck.checked ? guests * carlsBarRate : 0;
        var total = base + barCost;
        countEl.textContent = guests;
        carlsBarPrice.textContent = '+$' + (guests * carlsBarRate).toLocaleString();
        totalEl.innerHTML = 'Total: <strong>$' + total.toLocaleString() + '</strong> for ' + guests + ' guests' + (barCost ? ' (incl. bar ext.)' : '');
        badgeEl.innerHTML = '$' + total.toLocaleString() + ' for ' + guests + ' Guests<span class="per-person">$285/person' + (barCost ? ' + $40 bar ext.' : '') + '</span>';
      }

      if (slider) {
        slider.addEventListener('input', updateCarls);
        carlsBarCheck.addEventListener('change', updateCarls);
      }

      // ── Cantina zone picker + bar extension ──
      var currentZone = 'a';
      var zoneData = {
        a:    { guests: 24, total: 4680,  barExt: 25 },
        b:    { guests: 42, total: 8190,  barExt: 25 },
        both: { guests: 66, total: 12870, barExt: 25 }
      };
      var zoneBtns = document.querySelectorAll('.zone-btn');
      var cantinaBadge = document.getElementById('cantina-price-badge');
      var cantinaGuests = document.getElementById('cantina-guests');
      var cantinaPP = document.getElementById('cantina-pp');
      var cantinaTotal = document.getElementById('cantina-total');
      var cantinaBarCheck = document.getElementById('cantina-bar-check');
      var cantinaBarPrice = document.getElementById('cantina-bar-price');

      function updateCantina(zone) {
        currentZone = zone;
        var d = zoneData[zone];
        var pp = Math.round(d.total / d.guests);
        var barCost = cantinaBarCheck.checked ? d.guests * d.barExt : 0;
        var total = d.total + barCost;
        cantinaGuests.textContent = d.guests;
        cantinaPP.textContent = '~$' + (pp + (cantinaBarCheck.checked ? d.barExt : 0));
        cantinaBarPrice.textContent = '+$' + (d.guests * d.barExt).toLocaleString();
        cantinaTotal.textContent = '$' + total.toLocaleString();
        cantinaBadge.innerHTML = '$' + total.toLocaleString() + ' for ' + d.guests + ' Guests<span class="per-person">~$' + pp + '/person' + (barCost ? ' + $25 bar ext.' : '') + '</span>';

        zoneBtns.forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-zone') === zone);
        });
      }

      zoneBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          updateCantina(btn.getAttribute('data-zone'));
        });
      });

      cantinaBarCheck.addEventListener('change', function () {
        updateCantina(currentZone);
      });

      // ── Auto-load virtual tour iframes (always visible) ──
      document.querySelectorAll('.tour-frame').forEach(function (frame) {
        var src = frame.getAttribute('data-src');
        var wrapper = frame.querySelector('.iframe-wrapper');
        if (src && wrapper) {
          var iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('loading', 'lazy');
          wrapper.appendChild(iframe);
        }
        frame.classList.add('visible');
      });
    });
  </script>

</body>
</html>
