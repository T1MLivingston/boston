---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boston Meetup at Fenway Park</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style is:inline>
    :root {
      --navy: #0C2340;
      --red: #BD3039;
      --gold: #C8A951;
      --white: #F5F5F5;
      --card-bg: #FFFFFF;
      --text: #1a1a1a;
      --text-light: #555;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Open Sans', system-ui, sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.6;
    }

    h1, h2, h3, h4 {
      font-family: 'Oswald', system-ui, sans-serif;
      font-weight: 700;
      line-height: 1.2;
    }

    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(135deg, var(--navy) 0%, #1a3a5c 40%, var(--red) 100%);
      color: #fff;
      padding: 2rem;
      position: relative;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 3px 6px rgba(0,0,0,0.4);
    }

    .hero .subtitle {
      font-size: clamp(1rem, 2.5vw, 1.4rem);
      opacity: 0.9;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .hero .date {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--gold);
      margin-bottom: 2rem;
    }

    .hero .cta {
      display: inline-block;
      padding: 0.9rem 2.5rem;
      background: var(--gold);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .hero .cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }

    /* Baseball stitch divider */
    .stitch-divider {
      width: 100%;
      overflow: hidden;
      line-height: 0;
      background: var(--white);
    }

    .stitch-divider svg {
      display: block;
      width: 100%;
      height: 40px;
    }

    /* Packages */
    .packages {
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
    }

    .packages > h2 {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .packages > p {
      text-align: center;
      color: var(--text-light);
      margin-bottom: 3rem;
      font-size: 1.05rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      overflow: hidden;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .card-header {
      background: var(--navy);
      color: #fff;
      padding: 1.25rem 1.5rem;
    }

    .card-header h3 {
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .card-body {
      padding: 1.5rem;
    }

    .price-badge {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      padding: 0.5rem 1.2rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .price-badge .per-person {
      font-size: 0.85rem;
      font-weight: 400;
      opacity: 0.9;
      display: block;
    }

    .features {
      list-style: none;
      margin-bottom: 1.25rem;
    }

    .features li {
      padding: 0.4rem 0 0.4rem 1.5rem;
      position: relative;
      border-left: 3px solid var(--red);
      margin-bottom: 0.5rem;
      margin-left: 0.25rem;
      font-size: 0.95rem;
    }

    .features li::before {
      content: "\2713";
      position: absolute;
      left: 0.35rem;
      color: var(--red);
      font-weight: 700;
    }

    /* Toggle sections */
    .toggle-btn {
      display: inline-block;
      background: none;
      border: 2px solid var(--navy);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      transition: background 0.2s, color 0.2s;
      margin-right: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .toggle-btn:hover {
      background: var(--navy);
      color: #fff;
    }

    .toggle-btn.active {
      background: var(--navy);
      color: #fff;
    }

    .addons-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }

    .addons-content.visible {
      max-height: 500px;
    }

    .addons-content .inner {
      padding: 1rem 0;
      border-top: 1px solid #eee;
      margin-top: 0.75rem;
    }

    .addons-content ul {
      list-style: none;
      padding: 0;
    }

    .addons-content li {
      padding: 0.3rem 0 0.3rem 1.2rem;
      position: relative;
      color: var(--text-light);
      font-size: 0.9rem;
    }

    .addons-content li::before {
      content: "+";
      position: absolute;
      left: 0;
      color: var(--gold);
      font-weight: 700;
      font-size: 1.1rem;
    }

    /* Virtual tour */
    .tour-container {
      margin-top: 1rem;
    }

    .tour-frame {
      display: none;
      margin-top: 0.75rem;
    }

    .tour-frame.visible {
      display: block;
    }

    .tour-frame .iframe-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 6px;
      overflow: hidden;
      background: #ddd;
    }

    .tour-frame iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .tour-frame .fallback {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-light);
    }

    .tour-frame .fallback a {
      color: var(--red);
    }

    /* Comparison table */
    .comparison {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .comparison h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3vw, 2rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .comparison table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .comparison thead {
      background: var(--navy);
      color: #fff;
    }

    .comparison th {
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.75rem 1rem;
      text-align: left;
    }

    .comparison td {
      padding: 0.65rem 1rem;
      border-bottom: 1px solid #e0e0e0;
    }

    .comparison tbody tr:nth-child(even) {
      background: #f9f9f9;
    }

    .comparison tbody tr:hover {
      background: #f0f0f0;
    }

    /* Footer */
    footer {
      background: var(--navy);
      color: #ccc;
      text-align: center;
      padding: 2rem 1.5rem;
      font-size: 0.9rem;
    }

    footer strong {
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      display: block;
      margin-bottom: 0.25rem;
    }

    footer a {
      color: var(--gold);
      text-decoration: none;
    }

    footer a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .comparison table {
        font-size: 0.85rem;
      }

      .comparison th, .comparison td {
        padding: 0.5rem 0.6rem;
      }
    }
  </style>
</head>
<body>

  <!-- Hero -->
  <section class="hero">
    <h1>Boston Meetup<br>at Fenway Park</h1>
    <p class="subtitle">Join us for an unforgettable evening at America's Most Beloved Ballpark</p>
    <p class="date">Summer 2026 &mdash; Date TBD</p>
    <button class="cta" onclick="document.getElementById('packages').scrollIntoView({behavior:'smooth'})">
      Explore Packages &#9660;
    </button>
  </section>

  <!-- Stitch divider -->
  <div class="stitch-divider">
    <svg viewBox="0 0 1200 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 Q300,0 600,20 T1200,0 L1200,40 Z" fill="#0C2340"/>
      <path d="M0,20 Q150,5 300,18 Q450,32 600,18 Q750,5 900,18 Q1050,32 1200,18" fill="none" stroke="#BD3039" stroke-width="2.5" stroke-dasharray="8,6"/>
    </svg>
  </div>

  <!-- Packages -->
  <section class="packages" id="packages">
    <h2>Reception Packages</h2>
    <p>Two incredible options for your Fenway Park experience</p>

    <div class="cards">

      <!-- Card 1: Carl's Corner -->
      <div class="card">
        <div class="card-header">
          <h3>Carl's Corner Pre-Game Reception</h3>
        </div>
        <div class="card-body">
          <div class="price-badge">
            $4,275 for 15 Guests
            <span class="per-person">$285 per person</span>
          </div>
          <ul class="features">
            <li>2-hour pre-game reception in Carl's Corner space</li>
            <li>All-you-can-eat New England buffet for the full 2 hours</li>
            <li>Hosted bar &mdash; beer, wine, soda, water, seltzers (2 hrs)</li>
            <li>Dedicated server for your group</li>
            <li>Seats together in Pavilion Reserved 18 or 20, right next to your reception space</li>
          </ul>

          <button class="toggle-btn" data-target="addons-carls">Add-ons &amp; Details</button>
          <button class="toggle-btn" data-tour="tour-carls">Virtual Tour</button>

          <div class="addons-content" id="addons-carls">
            <div class="inner">
              <ul>
                <li>Up to 10 additional tickets at $285/person ($7,125 total for 25 guests max)</li>
                <li>Bar can be extended for an additional 2 hours at $40/person</li>
              </ul>
            </div>
          </div>

          <div class="tour-container">
            <div class="tour-frame" id="tour-carls" data-src="https://suiteview.com/tour/redsox-group/?s=pano49152">
              <div class="iframe-wrapper"></div>
              <span class="fallback">Can't see the tour? <a href="https://suiteview.com/tour/redsox-group/?s=pano49152" target="_blank" rel="noopener">Open in new tab &rarr;</a></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Hornitos Cantina -->
      <div class="card">
        <div class="card-header">
          <h3>Hornitos Cantina In-Game Reception</h3>
        </div>
        <div class="card-body">
          <div class="price-badge">
            $12,870 for 66 Guests
            <span class="per-person">~$195 per person</span>
          </div>
          <ul class="features">
            <li>Semi-private area with barstool &amp; tabletop seating</li>
            <li>Full access to the Cantina throughout the entire game</li>
            <li>TVs, drink rails, and tables for your group</li>
            <li>2-hour Ballpark favorites buffet starting at first pitch</li>
            <li>2-hour hosted bar &mdash; beer, wine, soda, water, seltzers (from first pitch)</li>
          </ul>

          <button class="toggle-btn" data-target="addons-cantina">Add-ons &amp; Details</button>
          <button class="toggle-btn" data-tour="tour-cantina">Virtual Tour</button>

          <div class="addons-content" id="addons-cantina">
            <div class="inner">
              <ul>
                <li>Bar extension: additional 2 hours for $25/person (at full 66 booking)</li>
                <li>Smaller bookings available: 24 guests ($4,680) or 42 guests ($8,190)</li>
                <li>Space may be shared with another group, but bar &amp; buffet are exclusive to your party</li>
              </ul>
            </div>
          </div>

          <div class="tour-container">
            <div class="tour-frame" id="tour-cantina" data-src="https://suiteview.com/tour/redsox-group/?s=pano49187">
              <div class="iframe-wrapper"></div>
              <span class="fallback">Can't see the tour? <a href="https://suiteview.com/tour/redsox-group/?s=pano49187" target="_blank" rel="noopener">Open in new tab &rarr;</a></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comparison">
    <h2>Quick Comparison</h2>
    <table>
      <thead>
        <tr>
          <th></th>
          <th>Carl's Corner</th>
          <th>Hornitos Cantina</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Guests</strong></td>
          <td>15 (up to 25)</td>
          <td>66 (or 24 / 42)</td>
        </tr>
        <tr>
          <td><strong>Timing</strong></td>
          <td>Pre-game (2 hrs before first pitch)</td>
          <td>In-game (starts at first pitch)</td>
        </tr>
        <tr>
          <td><strong>Per Person</strong></td>
          <td>$285</td>
          <td>~$195</td>
        </tr>
        <tr>
          <td><strong>Food</strong></td>
          <td>New England buffet</td>
          <td>Ballpark favorites buffet</td>
        </tr>
        <tr>
          <td><strong>Seating</strong></td>
          <td>Pavilion Reserved 18/20</td>
          <td>Barstool &amp; tabletop (in-space)</td>
        </tr>
        <tr>
          <td><strong>Bar Extension</strong></td>
          <td>+2 hrs @ $40/person</td>
          <td>+2 hrs @ $25/person</td>
        </tr>
        <tr>
          <td><strong>Total (Base)</strong></td>
          <td>$4,275</td>
          <td>$12,870</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Footer -->
  <footer>
    <strong>Fenway Park &bull; Boston, MA</strong>
    <p>4 Jersey Street, Boston, MA 02215</p>
  </footer>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Toggle add-ons sections
      document.querySelectorAll('[data-target]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.getAttribute('data-target'));
          if (target) {
            target.classList.toggle('visible');
            btn.classList.toggle('active');
          }
        });
      });

      // Toggle virtual tour iframes (lazy-load on first click)
      document.querySelectorAll('[data-tour]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var frame = document.getElementById(btn.getAttribute('data-tour'));
          if (!frame) return;

          // Lazy-load iframe on first open
          if (!frame.querySelector('iframe')) {
            var src = frame.getAttribute('data-src');
            var wrapper = frame.querySelector('.iframe-wrapper');
            if (src && wrapper) {
              var iframe = document.createElement('iframe');
              iframe.src = src;
              iframe.setAttribute('allowfullscreen', '');
              iframe.setAttribute('loading', 'lazy');
              wrapper.appendChild(iframe);
            }
          }

          frame.classList.toggle('visible');
          btn.classList.toggle('active');
        });
      });
    });
  </script>

</body>
</html>
