---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boston Web3 Meetup at Fenway Park</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style is:inline>
    :root {
      --navy: #0C2340;
      --red: #BD3039;
      --gold: #C8A951;
      --white: #F5F5F5;
      --card-bg: #FFFFFF;
      --text: #1a1a1a;
      --text-light: #555;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Open Sans', system-ui, sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.6;
    }

    h1, h2, h3, h4 {
      font-family: 'Oswald', system-ui, sans-serif;
      font-weight: 700;
      line-height: 1.2;
    }

    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(135deg, var(--navy) 0%, #1a3a5c 40%, var(--red) 100%);
      color: #fff;
      padding: 2rem;
      position: relative;
    }

    .hero-logo {
      width: clamp(120px, 20vw, 200px);
      height: auto;
      margin-bottom: 1.5rem;
      filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
    }

    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 3px 6px rgba(0,0,0,0.4);
    }

    .hero .subtitle {
      font-size: clamp(1rem, 2.5vw, 1.4rem);
      opacity: 0.9;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .hero .date {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--gold);
      margin-bottom: 2rem;
    }

    .hero-cta-link {
      display: inline-block;
      transition: transform 0.2s, box-shadow 0.2s;
      border-radius: 8px;
      overflow: hidden;
    }

    .hero-cta-link:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    }

    .hero-cta-img {
      display: block;
      width: clamp(220px, 30vw, 340px);
      height: auto;
      border-radius: 8px;
    }

    .hero .scroll-btn {
      display: inline-block;
      margin-top: 1.5rem;
      padding: 0.7rem 2rem;
      background: transparent;
      border: 2px solid rgba(255,255,255,0.5);
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .hero .scroll-btn:hover {
      background: rgba(255,255,255,0.15);
      border-color: #fff;
    }

    /* Stitch divider */
    .stitch-divider {
      width: 100%;
      overflow: hidden;
      line-height: 0;
      background: var(--white);
    }

    .stitch-divider svg {
      display: block;
      width: 100%;
      height: 40px;
    }

    /* Game Series */
    .series {
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 1.5rem 2rem;
    }

    .series > h2 {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .series > p {
      text-align: center;
      color: var(--text-light);
      margin-bottom: 2.5rem;
      font-size: 1.05rem;
    }

    .series-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .series-card {
      background: var(--card-bg);
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      overflow: hidden;
      text-align: center;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .series-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .series-card-header {
      background: var(--navy);
      color: #fff;
      padding: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .series-card-header img {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .series-card-header h3 {
      font-size: 1.2rem;
      text-transform: uppercase;
    }

    .series-card-body {
      padding: 1.5rem;
    }

    .series-dates {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      color: var(--red);
      margin-bottom: 0.5rem;
    }

    .series-opponent {
      font-size: 1rem;
      color: var(--text-light);
    }

    .series-badge {
      display: inline-block;
      background: var(--gold);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.3rem 0.8rem;
      border-radius: 3px;
      text-transform: uppercase;
      margin-top: 0.75rem;
    }

    /* Packages */
    .packages {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
    }

    .packages > h2 {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .packages > p {
      text-align: center;
      color: var(--text-light);
      margin-bottom: 3rem;
      font-size: 1.05rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      overflow: hidden;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .card-header {
      background: var(--navy);
      color: #fff;
      padding: 1.25rem 1.5rem;
    }

    .card-header h3 {
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .card-body {
      padding: 1.5rem;
    }

    .price-badge {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      padding: 0.5rem 1.2rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .price-badge .per-person {
      font-size: 0.85rem;
      font-weight: 400;
      opacity: 0.9;
      display: block;
    }

    .features {
      list-style: none;
      margin-bottom: 1.25rem;
    }

    .features li {
      padding: 0.4rem 0 0.4rem 1.5rem;
      position: relative;
      border-left: 3px solid var(--red);
      margin-bottom: 0.5rem;
      margin-left: 0.25rem;
      font-size: 0.95rem;
    }

    .features li::before {
      content: "\2713";
      position: absolute;
      left: 0.35rem;
      color: var(--red);
      font-weight: 700;
    }

    /* Slider */
    .slider-section {
      margin: 1.25rem 0;
      padding: 1rem;
      background: #f7f7f7;
      border-radius: 8px;
    }

    .slider-section label {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .slider-row {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .slider-row input[type="range"] {
      flex: 1;
      accent-color: var(--red);
      height: 6px;
      cursor: pointer;
    }

    .slider-value {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--red);
      min-width: 2.5ch;
      text-align: center;
    }

    .slider-total {
      margin-top: 0.5rem;
      font-size: 0.95rem;
      color: var(--text-light);
    }

    .slider-total strong {
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
    }

    /* Cantina layout explainer */
    .cantina-layout {
      margin: 1rem 0;
      padding: 1rem;
      background: #f7f7f7;
      border-radius: 8px;
    }

    .cantina-layout h4 {
      font-size: 1rem;
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .cantina-zones {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .cantina-zone {
      flex: 1;
      background: var(--navy);
      color: #fff;
      border-radius: 6px;
      padding: 0.75rem;
      text-align: center;
      font-size: 0.85rem;
    }

    .cantina-zone strong {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }

    .cantina-zone .zone-price {
      color: var(--gold);
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
    }

    .cantina-note {
      font-size: 0.85rem;
      color: var(--text-light);
      font-style: italic;
    }

    /* Toggle sections */
    .toggle-btn {
      display: inline-block;
      background: none;
      border: 2px solid var(--navy);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      transition: background 0.2s, color 0.2s;
      margin-right: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .toggle-btn:hover {
      background: var(--navy);
      color: #fff;
    }

    .toggle-btn.active {
      background: var(--navy);
      color: #fff;
    }

    .addons-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }

    .addons-content.visible {
      max-height: 500px;
    }

    .addons-content .inner {
      padding: 1rem 0;
      border-top: 1px solid #eee;
      margin-top: 0.75rem;
    }

    .addons-content ul {
      list-style: none;
      padding: 0;
    }

    .addons-content li {
      padding: 0.3rem 0 0.3rem 1.2rem;
      position: relative;
      color: var(--text-light);
      font-size: 0.9rem;
    }

    .addons-content li::before {
      content: "+";
      position: absolute;
      left: 0;
      color: var(--gold);
      font-weight: 700;
      font-size: 1.1rem;
    }

    /* Virtual tour */
    .tour-container {
      margin-top: 1rem;
    }

    .tour-frame {
      display: none;
      margin-top: 0.75rem;
    }

    .tour-frame.visible {
      display: block;
    }

    .tour-frame .iframe-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 6px;
      overflow: hidden;
      background: #ddd;
    }

    .tour-frame iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .tour-frame .fallback {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-light);
    }

    .tour-frame .fallback a {
      color: var(--red);
    }

    /* Comparison table */
    .comparison {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .comparison h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3vw, 2rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .comparison table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .comparison thead {
      background: var(--navy);
      color: #fff;
    }

    .comparison th {
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.75rem 1rem;
      text-align: left;
    }

    .comparison td {
      padding: 0.65rem 1rem;
      border-bottom: 1px solid #e0e0e0;
    }

    .comparison tbody tr:nth-child(even) {
      background: #f9f9f9;
    }

    .comparison tbody tr:hover {
      background: #f0f0f0;
    }

    /* Event Planners */
    .planners {
      max-width: 900px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
      text-align: center;
    }

    .planners h2 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .planners > p {
      color: var(--text-light);
      margin-bottom: 2.5rem;
      font-size: 1.05rem;
    }

    .planners-grid {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .planner {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s;
    }

    .planner:hover {
      transform: translateY(-4px);
    }

    .planner-img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--navy);
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      transition: border-color 0.2s;
    }

    .planner:hover .planner-img {
      border-color: var(--red);
    }

    .planner-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      margin-top: 0.75rem;
      color: var(--navy);
    }

    .planner-handle {
      font-size: 0.85rem;
      color: var(--text-light);
      margin-top: 0.15rem;
    }

    /* Footer */
    footer {
      background: var(--navy);
      color: #ccc;
      text-align: center;
      padding: 2rem 1.5rem;
      font-size: 0.9rem;
    }

    footer strong {
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      display: block;
      margin-bottom: 0.25rem;
    }

    footer a {
      color: var(--gold);
      text-decoration: none;
    }

    footer a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .series-cards {
        grid-template-columns: 1fr;
      }

      .comparison table {
        font-size: 0.85rem;
      }

      .comparison th, .comparison td {
        padding: 0.5rem 0.6rem;
      }

      .cantina-zones {
        flex-direction: column;
      }

      .planners-grid {
        gap: 2rem;
      }

      .planner-img {
        width: 100px;
        height: 100px;
      }
    }
  </style>
</head>
<body>

  <!-- Hero -->
  <section class="hero">
    <img src="https://cdn.prod.website-files.com/64aa957da446d8dc44869f81/69b78fe2b73770a04d4576e6_27f15ca4-9bfa-4224-8dea-c2884004a2ca.png" alt="Boston Web3 Logo" class="hero-logo" />
    <h1>Boston Web3 Meetup<br>at Fenway Park</h1>
    <p class="subtitle">Join us for an unforgettable evening at America's Most Beloved Ballpark</p>
    <p class="date">Summer 2026 &mdash; Dates Below</p>
    <a href="https://cdn.prod.website-files.com/64aa957da446d8dc44869f81/69b883c24f1a4fb5ed732a26_web3_boston.png" class="hero-cta-link" target="_blank" rel="noopener">
      <img src="https://cdn.prod.website-files.com/64aa957da446d8dc44869f81/69b883c24f1a4fb5ed732a26_web3_boston.png" alt="Sign up — Fill out the form" class="hero-cta-img" />
    </a>
    <button class="scroll-btn" onclick="document.getElementById('series').scrollIntoView({behavior:'smooth'})">
      See the Games &#9660;
    </button>
  </section>

  <!-- Stitch divider -->
  <div class="stitch-divider">
    <svg viewBox="0 0 1200 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 Q300,0 600,20 T1200,0 L1200,40 Z" fill="#0C2340"/>
      <path d="M0,20 Q150,5 300,18 Q450,32 600,18 Q750,5 900,18 Q1050,32 1200,18" fill="none" stroke="#BD3039" stroke-width="2.5" stroke-dasharray="8,6"/>
    </svg>
  </div>

  <!-- Game Series -->
  <section class="series" id="series">
    <h2>The Games</h2>
    <p>Two potential series we're targeting — vote for your favorite!</p>

    <div class="series-cards">

      <!-- Series 1: Yankees -->
      <div class="series-card">
        <div class="series-card-header">
          <img src="https://a.espncdn.com/i/teamlogos/mlb/500/nyy.png" alt="New York Yankees Logo" />
          <h3>Red Sox vs. Yankees</h3>
        </div>
        <div class="series-card-body">
          <div class="series-dates">June 25 &ndash; 28, 2026</div>
          <div class="series-opponent">4-game series at Fenway Park &mdash; the ultimate rivalry</div>
          <div class="series-badge">Option A</div>
        </div>
      </div>

      <!-- Series 2: Blue Jays -->
      <div class="series-card">
        <div class="series-card-header">
          <img src="https://a.espncdn.com/i/teamlogos/mlb/500/tor.png" alt="Toronto Blue Jays Logo" />
          <h3>Red Sox vs. Blue Jays</h3>
        </div>
        <div class="series-card-body">
          <div class="series-dates">July 24 &ndash; 26, 2026</div>
          <div class="series-opponent">3-game series at Fenway Park &mdash; AL East divisional battle</div>
          <div class="series-badge">Option B</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Packages -->
  <section class="packages" id="packages">
    <h2>Reception Packages</h2>
    <p>Two incredible options for your Fenway Park experience</p>

    <div class="cards">

      <!-- Card 1: Carl's Corner -->
      <div class="card">
        <div class="card-header">
          <h3>Carl's Corner Pre-Game Reception</h3>
        </div>
        <div class="card-body">
          <div class="price-badge" id="carls-price-badge">
            $4,275 for 15 Guests
            <span class="per-person">$285 per person</span>
          </div>

          <!-- Guest Slider -->
          <div class="slider-section">
            <label for="carls-slider">Choose Your Group Size</label>
            <div class="slider-row">
              <span style="font-size:0.85rem;color:var(--text-light)">15</span>
              <input type="range" id="carls-slider" min="15" max="25" value="15" />
              <span style="font-size:0.85rem;color:var(--text-light)">25</span>
              <span class="slider-value" id="carls-count">15</span>
            </div>
            <div class="slider-total" id="carls-total">
              Total: <strong>$4,275</strong> for 15 guests at $285/person
            </div>
          </div>

          <ul class="features">
            <li>2-hour pre-game reception in Carl's Corner space</li>
            <li>All-you-can-eat New England buffet for the full 2 hours</li>
            <li>Hosted bar &mdash; beer, wine, soda, water, seltzers (2 hrs)</li>
            <li>Dedicated server for your group</li>
            <li>Seats together in Pavilion Reserved 18 or 20, right next to your reception space</li>
          </ul>

          <button class="toggle-btn" data-target="addons-carls">Add-ons &amp; Details</button>
          <button class="toggle-btn" data-tour="tour-carls">Virtual Tour</button>

          <div class="addons-content" id="addons-carls">
            <div class="inner">
              <ul>
                <li>Up to 25 total guests — use the slider above to adjust</li>
                <li>Bar can be extended for an additional 2 hours at $40/person</li>
              </ul>
            </div>
          </div>

          <div class="tour-container">
            <div class="tour-frame" id="tour-carls" data-src="https://suiteview.com/tour/redsox-group/?s=pano49152">
              <div class="iframe-wrapper"></div>
              <span class="fallback">Can't see the tour? <a href="https://suiteview.com/tour/redsox-group/?s=pano49152" target="_blank" rel="noopener">Open in new tab &rarr;</a></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Hornitos Cantina -->
      <div class="card">
        <div class="card-header">
          <h3>Hornitos Cantina In-Game Reception</h3>
        </div>
        <div class="card-body">
          <div class="price-badge">
            From $4,680
            <span class="per-person">Starting at 24 guests</span>
          </div>

          <ul class="features">
            <li>Semi-private area with barstool &amp; tabletop seating</li>
            <li>Full access to the Cantina throughout the entire game</li>
            <li>TVs, drink rails, and tables for your group</li>
            <li>2-hour Ballpark favorites buffet starting at first pitch</li>
            <li>2-hour hosted bar &mdash; beer, wine, soda, water, seltzers</li>
          </ul>

          <!-- Cantina Layout Explainer -->
          <div class="cantina-layout">
            <h4>Flexible Booking — Two Separable Areas</h4>
            <p style="font-size:0.9rem;color:var(--text-light);margin-bottom:0.75rem;">
              The Cantina is divided into <strong>two distinct zones</strong> that can be booked independently or combined for a larger group.
            </p>
            <div class="cantina-zones">
              <div class="cantina-zone">
