  <!-- Footer -->
  <footer>
    <strong>Fenway Park &bull; Boston, MA</strong>
    <p>4 Jersey Street, Boston, MA 02215</p>
  </footer>

  <script is:inline>
    function handleFormSubmit(e) {
      e.preventDefault();
      var form = document.getElementById('boston-web3-form');
      var success = document.getElementById('form-success');
      form.style.display = 'none';
      success.style.display = 'block';
    }

    document.addEventListener('DOMContentLoaded', function () {
      // Carl's Corner guest slider
      var slider = document.getElementById('carls-slider');
      var countEl = document.getElementById('carls-count');
      var totalEl = document.getElementById('carls-total');
      var badgeEl = document.getElementById('carls-price-badge');
      var pricePerPerson = 285;

      function updateCarls() {
        var guests = parseInt(slider.value, 10);
        var total = guests * pricePerPerson;
        countEl.textContent = guests;
        totalEl.innerHTML = 'Total: <strong>$' + total.toLocaleString() + '</strong> for ' + guests + ' guests at $285/person';
        badgeEl.innerHTML = '$' + total.toLocaleString() + ' for ' + guests + ' Guests<span class="per-person">$285 per person</span>';
      }

      if (slider) {
        slider.addEventListener('input', updateCarls);
      }

      // Cantina zone picker / calculator
      var zoneData = {
        a:    { guests: 24, total: 4680,  barExt: 25 },
        b:    { guests: 42, total: 8190,  barExt: 25 },
        both: { guests: 66, total: 12870, barExt: 25 }
      };
      var zoneBtns = document.querySelectorAll('.zone-btn');
      var cantinaBadge = document.getElementById('cantina-price-badge');
      var cantinaGuests = document.getElementById('cantina-guests');
      var cantinaPP = document.getElementById('cantina-pp');
      var cantinaBar = document.getElementById('cantina-bar');
      var cantinaTotal = document.getElementById('cantina-total');

      function updateCantina(zone) {
        var d = zoneData[zone];
        var pp = Math.round(d.total / d.guests);
        var barCost = d.guests * d.barExt;
        cantinaGuests.textContent = d.guests;
        cantinaPP.textContent = '~$' + pp;
        cantinaBar.textContent = '+$' + barCost.toLocaleString();
        cantinaTotal.textContent = '$' + d.total.toLocaleString();
        cantinaBadge.innerHTML = '$' + d.total.toLocaleString() + ' for ' + d.guests + ' Guests<span class="per-person">~$' + pp + ' per person</span>';

        zoneBtns.forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-zone') === zone);
        });
      }

      zoneBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          updateCantina(btn.getAttribute('data-zone'));
        });
      });

      // Toggle add-ons sections
      document.querySelectorAll('[data-target]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.getAttribute('data-target'));
          if (target) {
            target.classList.toggle('visible');
            btn.classList.toggle('active');
          }
        });
      });

      // Auto-load and show virtual tour iframes
      document.querySelectorAll('.tour-frame').forEach(function (frame) {
        var src = frame.getAttribute('data-src');
        var wrapper = frame.querySelector('.iframe-wrapper');
        if (src && wrapper) {
          var iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('loading', 'lazy');
          wrapper.appendChild(iframe);
        }
        frame.classList.add('visible');
      });

      // Still allow toggling tours via button
      document.querySelectorAll('[data-tour]').forEach(function (btn) {
        btn.classList.add('active');
        btn.addEventListener('click', function () {
          var frame = document.getElementById(btn.getAttribute('data-tour'));
          if (!frame) return;
          frame.classList.toggle('visible');
          btn.classList.toggle('active');
        });
      });
    });
  </script>

</body>
</html>
