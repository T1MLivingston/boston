---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boston Web3 Meetup at Fenway Park</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style is:inline>
    :root {
      --navy: #0C2340;
      --red: #BD3039;
      --gold: #C8A951;
      --white: #F5F5F5;
      --card-bg: #FFFFFF;
      --text: #1a1a1a;
      --text-light: #555;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Open Sans', system-ui, sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.6;
    }

    h1, h2, h3, h4 {
      font-family: 'Oswald', system-ui, sans-serif;
      font-weight: 700;
      line-height: 1.2;
    }

    /* Hero */
    .hero {
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(135deg, rgba(12,35,64,0.88) 0%, rgba(26,58,92,0.82) 40%, rgba(189,48,57,0.75) 100%),
        url('https://cdn.prod.website-files.com/64aa957da446d8dc44869f81/69b8d937e2a5ef57890eeff3_Pavilion%20Hospitality%20Seat%20View.jpg') center/cover no-repeat;
      color: #fff;
      padding: 3rem 2rem;
      position: relative;
    }

    .hero-inner {
      display: flex;
      align-items: center;
      gap: clamp(2rem, 5vw, 4rem);
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
    }

    .hero-logo {
      width: clamp(200px, 28vw, 360px);
      height: auto;
      flex-shrink: 0;
      filter: drop-shadow(0 6px 20px rgba(0,0,0,0.4));
    }

    .hero-text {
      text-align: left;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 4rem);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 3px 6px rgba(0,0,0,0.4);
    }

    .hero .subtitle {
      font-size: clamp(1rem, 2.2vw, 1.3rem);
      opacity: 0.9;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .hero .date {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--gold);
      margin-bottom: 0.75rem;
    }

    .hero-series-inline {
      display: flex;
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .hero-series-chip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 8px;
      padding: 0.5rem 1rem;
      color: #fff;
      font-size: 0.9rem;
      transition: background 0.2s;
    }

    .hero-series-chip:hover {
      background: rgba(255,255,255,0.2);
    }

    .hero-series-chip img {
      width: 28px;
      height: 28px;
      object-fit: contain;
    }


    .hero-series-chip .chip-dates {
      font-family: 'Oswald', sans-serif;
      color: var(--gold);
      font-size: 0.8rem;
      display: block;
    }

    /* Interest CTA Section */
    .interest-cta {
      background: var(--navy);
      padding: 4rem 1.5rem;
      text-align: center;
    }

    .interest-cta-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .interest-cta h2 {
      color: #fff;
      margin-bottom: 0.5rem;
    }

    .interest-cta > .interest-cta-inner > p {
      color: rgba(255,255,255,0.8);
      font-size: 1.05rem;
      margin-bottom: 2rem;
    }

    .fenway-cta-wrapper {
      display: block;
      max-width: 900px;
      margin: 0 auto 2rem;
      border: 4px solid var(--gold);
      border-radius: 12px;
      padding: 6px;
      box-shadow: 0 0 30px rgba(200,169,81,0.3);
      transition: box-shadow 0.3s, transform 0.3s;
      cursor: pointer;
      text-decoration: none;
    }

    .fenway-cta-wrapper:hover {
      box-shadow: 0 0 45px rgba(200,169,81,0.5);
      transform: translateY(-3px);
    }

    .fenway-cta-img {
      display: block;
      width: 100%;
      max-width: 900px;
      height: 200px;
      object-fit: cover;
      object-position: center 70%;
      border-radius: 8px;
    }

    /* Interest Form */
    .interest-form {
      max-width: 600px;
      margin: 0 auto;
      text-align: left;
    }

    .interest-form h3 {
      font-size: 1.4rem;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 0.4rem;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 0.65rem 0.9rem;
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 6px;
      background: rgba(255,255,255,0.1);
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 0.95rem;
      transition: border-color 0.2s;
    }

    .form-group input::placeholder {
      color: rgba(255,255,255,0.5);
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--gold);
    }

    .form-group select {
      cursor: pointer;
    }

    .form-group select option {
      background: var(--navy);
      color: #fff;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-submit {
      display: block;
      width: 100%;
      padding: 0.85rem;
      background: var(--gold);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: background 0.2s, transform 0.2s;
    }

    .form-submit:hover {
      background: #d4b85c;
      transform: translateY(-2px);
    }

    .form-success {
      display: none;
      text-align: center;
      padding: 2rem;
      color: var(--gold);
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
    }

    /* Stitch divider */
    .stitch-divider {
      width: 100%;
      overflow: hidden;
      line-height: 0;
      background: var(--white);
    }

    .stitch-divider svg {
      display: block;
      width: 100%;
      height: 40px;
    }

    /* Game Schedule */
    .game-schedule-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem 1rem;
    }

    .section-title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--navy);
      text-transform: uppercase;
    }

    .section-title::before,
    .section-title::after {
      content: '';
      flex: 0 0 60px;
      height: 0;
      border-top: 3px dashed var(--red);
    }

    .game-schedule-section > h2 {
      margin-bottom: 2rem;
    }

    .schedule-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      max-width: 700px;
      margin: 0 auto;
    }

    .schedule-block {
      background: var(--card-bg);
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      overflow: hidden;
    }

    .schedule-block-header {
      background: var(--navy);
      color: #fff;
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .schedule-block-header .team-logo-left,
    .schedule-block-header .team-logo-right {
      width: 40px;
      height: 40px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .schedule-header-center {
      flex: 1;
      text-align: center;
    }

    .schedule-block-header h3 {
      font-size: 1.05rem;
      text-transform: uppercase;
    }

    .schedule-block-header .schedule-badge {
      display: inline-block;
      background: var(--gold);
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      text-transform: uppercase;
      margin-top: 0.2rem;
    }

    .game-schedule {
      text-align: left;
    }

    .game-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 1rem;
      border-bottom: 1px solid #eee;
      font-size: 0.9rem;
    }

    .game-row:last-child {
      border-bottom: none;
    }

    .game-day {
      font-weight: 600;
      color: var(--navy);
      min-width: 90px;
    }

    .game-time {
      font-family: 'Oswald', sans-serif;
      color: var(--red);
      font-weight: 600;
    }

    .game-footnote {
      font-size: 0.78rem;
      color: var(--text-light);
      font-style: italic;
      padding: 0.3rem 1rem 0.5rem;
      margin: 0;
      font-weight: 600;
    }

    /* Packages */
    .packages {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
    }

    .packages > h2 {
      margin-bottom: 0.5rem;
    }

    .packages > p {
      text-align: center;
      color: var(--text-light);
      margin-bottom: 3rem;
      font-size: 1.05rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2rem;
      align-items: stretch;
    }

    .card {
      background: var(--card-bg);
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      overflow: hidden;
      transition: transform 0.25s, box-shadow 0.25s;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border: 2px dashed transparent;
      border-radius: 10px;
      pointer-events: none;
      transition: border-color 0.3s;
    }

    .card:hover::after {
      border-color: var(--red);
    }

    .card-header {
      background: var(--navy);
      color: #fff;
      padding: 1.25rem 1.5rem;
    }

    .card-header h3 {
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .card-header h3 span {
      display: block;
      font-size: 0.8rem;
      font-weight: 400;
      opacity: 0.8;
      letter-spacing: 0.06em;
      margin-top: 0.15rem;
    }

    .card-body {
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .price-badge {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      padding: 0.5rem 1.2rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .price-badge .per-person {
      font-size: 0.85rem;
      font-weight: 400;
      opacity: 0.9;
      display: block;
    }

    .features {
      list-style: none;
      margin-bottom: 1rem;
    }

    .features li {
      padding: 0.25rem 0 0.25rem 1.4rem;
      position: relative;
      border-left: 3px solid var(--red);
      margin-bottom: 0.3rem;
      margin-left: 0.25rem;
      font-size: 0.84rem;
      line-height: 1.4;
    }

    .features li::before {
      content: "\2713";
      position: absolute;
      left: 0.3rem;
      color: var(--red);
      font-weight: 700;
      font-size: 0.8rem;
    }

    /* Bar extension add-on checkbox */
    .addon-check {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, #f8f4eb, #fff);
      border: 2px solid var(--gold);
      border-radius: 8px;
      padding: 0.6rem 0.9rem;
      margin: 0.75rem 0;
      cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .addon-check:hover {
      box-shadow: 0 2px 10px rgba(200,169,81,0.25);
    }

    .addon-check input[type="checkbox"] {
      accent-color: var(--gold);
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    .addon-check-text {
      font-size: 0.84rem;
      color: var(--text);
      line-height: 1.3;
    }

    .addon-check-text strong {
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 0.9rem;
    }

    .addon-check-price {
      margin-left: auto;
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      color: var(--red);
      font-size: 0.9rem;
      white-space: nowrap;
    }

    /* Card spacer to push bottom content down */
    .card-spacer {
      flex: 1;
    }

    /* Slider */
    .slider-section {
      margin: 1.25rem 0;
      padding: 1rem;
      background: #f7f7f7;
      border-radius: 8px;
    }

    .slider-section label {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .slider-row {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .slider-row input[type="range"] {
      flex: 1;
      accent-color: var(--red);
      height: 6px;
      cursor: pointer;
    }

    .slider-value {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--red);
      min-width: 2.5ch;
      text-align: center;
    }

    .slider-total {
      margin-top: 0.5rem;
      font-size: 0.95rem;
      color: var(--text-light);
    }

    .slider-total strong {
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
    }

    /* Cantina layout explainer */
    .cantina-layout {
      margin: 1rem 0;
      padding: 1rem;
      background: #f7f7f7;
      border-radius: 8px;
    }

    .cantina-layout h4 {
      font-size: 1rem;
      color: var(--navy);
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .cantina-zones {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .cantina-zone {
      flex: 1;
      background: var(--navy);
      color: #fff;
      border-radius: 6px;
      padding: 0.75rem;
      text-align: center;
      font-size: 0.85rem;
    }

    .cantina-zone strong {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }

    .cantina-zone .zone-price {
      color: var(--gold);
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
    }

    .cantina-note {
      font-size: 0.85rem;
      color: var(--text-light);
      font-style: italic;
    }

    /* Zone Picker */
    .zone-picker {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .zone-btn {
      flex: 1;
      background: #fff;
      border: 2px solid #ddd;
      border-radius: 8px;
      padding: 0.75rem 0.5rem;
      cursor: pointer;
      text-align: center;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
    }

    .zone-btn:hover {
      border-color: var(--navy);
      transform: translateY(-2px);
    }

    .zone-btn.active {
      border-color: var(--red);
      background: rgba(189,48,57,0.08);
    }

    .zone-btn-label {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--navy);
      text-transform: uppercase;
    }

    .zone-btn-detail {
      display: block;
      font-size: 0.78rem;
      color: var(--text-light);
      margin-top: 0.2rem;
    }

    .cantina-calc {
      background: #fff;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      border: 1px solid #eee;
    }

    .cantina-calc-row {
      display: flex;
      justify-content: space-between;
      padding: 0.35rem 0;
      font-size: 0.9rem;
      color: var(--text-light);
    }

    .cantina-calc-row strong {
      color: var(--navy);
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
    }

    .cantina-calc-row.total {
      border-top: 2px solid var(--navy);
      margin-top: 0.35rem;
      padding-top: 0.5rem;
    }

    .cantina-calc-row.total span {
      font-weight: 700;
      color: var(--navy);
    }

    .cantina-calc-row.total strong {
      color: var(--red);
      font-size: 1.15rem;
    }

    /* Tour label */
    .tour-label {
      display: block;
      font-family: 'Oswald', sans-serif;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
      margin-bottom: 0.4rem;
    }

    /* Virtual tour */
    .tour-container {
      margin-bottom: 1rem;
    }

    .tour-frame {
      display: none;
      margin-top: 0.75rem;
    }

    .tour-frame.visible {
      display: block;
    }

    .tour-frame .iframe-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 6px;
      overflow: hidden;
      background: #ddd;
    }

    .tour-frame iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .tour-frame .fallback {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-light);
    }

    .tour-frame .fallback a {
      color: var(--red);
    }

    /* Comparison table */
    .comparison {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .comparison h2 {
      margin-bottom: 1.5rem;
    }

    .comparison table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .comparison thead {
      background: var(--navy);
      color: #fff;
    }

    .comparison th {
      font-family: 'Oswald', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.85rem 1rem;
      text-align: left;
    }

    .comparison th:first-child {
      width: 130px;
    }

    .comparison td {
      padding: 0.65rem 1rem;
      border-bottom: 1px solid #e8e8e8;
    }

    .comparison td:first-child {
      background: rgba(12,35,64,0.04);
      border-left: 3px solid var(--navy);
    }

    .comparison tbody tr:nth-child(even) {
      background: #fafafa;
    }

    .comparison tbody tr:nth-child(even) td:first-child {
      background: rgba(12,35,64,0.06);
    }

    .comparison tbody tr:hover {
      background: rgba(189,48,57,0.04);
    }

    .comparison tbody tr:last-child td {
      border-bottom: none;
      font-weight: 600;
    }

    .comparison tbody tr:last-child td:first-child {
      border-left-color: var(--red);
    }

    /* Event Planners */
    .planners {
      max-width: 900px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
      text-align: center;
    }

    .planners h2 {
      margin-bottom: 0.5rem;
    }

    .planners > p {
      color: var(--text-light);
      margin-bottom: 2.5rem;
      font-size: 1.05rem;
    }

    .planners-grid {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .planner {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s;
    }

    .planner:hover {
      transform: translateY(-4px);
    }

    .planner-img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--navy);
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      transition: border-color 0.2s;
    }

    .planner:hover .planner-img {
      border-color: var(--red);
    }

    .planner-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      margin-top: 0.75rem;
      color: var(--navy);
    }

    .planner-handle {
      font-size: 0.85rem;
      color: var(--text-light);
      margin-top: 0.15rem;
    }

    /* Footer */
    footer {
      background: var(--navy);
      color: #ccc;
